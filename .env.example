# Firebase web app settings: Firebase console > Project settings > Your apps > Web app > Config.
# Copy this file to .env and fill it in. Restart the dev server afterwards.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# reCAPTCHA v3 site key registered in Firebase App Check (blocks requests that don't come from the website).
VITE_RECAPTCHA_SITE_KEY=
